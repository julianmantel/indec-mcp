# Token JWT obtenido del portal de la API del INDEC (https://api.indec.gob.ar/)
# OBLIGATORIO
INDEC_API_TOKEN=

# URL base de la API (solo HTTPS o localhost)
# OBLIGATORIO
INDEC_API_BASE_URL=https://api.indec.gob.ar/v1/

# Hosts permitidos para la URL base, separados por coma y sin puerto.
# Por defecto: api.indec.gob.ar,localhost,127.0.0.1,::1,[::1]
# OPCIONAL
INDEC_API_ALLOWED_HOSTS=

# Tiempo de vida de la caché en memoria en segundos (0 para desactivar)
# OPCIONAL
INDEC_CACHE_TTL_SECONDS=3600

# Timeout para solicitudes HTTP en milisegundos
# OPCIONAL
INDEC_REQUEST_TIMEOUT_MS=30000
